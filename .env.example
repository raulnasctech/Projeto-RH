# Copie este arquivo para .env e informe a URL base do API Group "Authentication" no Xano.
# Exemplo: https://seu-workspace.n7.xano.io/api:abcd1234
XANO_AUTH_API_URL=

# URL base do API Group "rh_api" no Xano (use o canonical do grupo configurado).
# Exemplo: https://seu-workspace.n7.xano.io/api:seu-canonical
XANO_RH_API_URL=
